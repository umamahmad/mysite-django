{
  "model": "blog.post",
  "pk": 8,
  "fields": {
    "title": "Why I Like Python",
    "slug": "why-i-like-python",
    "author": 3,
    "body": "Python is one of the most popular programming languages in the world. It is simple, readable, and powerful. Developers use Python for web development, data science, artificial intelligence, and automation. Django is a web framework written in Python that helps developers build secure and scalable web applications quickly. Learning Python has opened many opportunities in the world of programming.",
    "publish": "2026-03-10T11:37:01Z",
    "created": "2026-03-10T11:38:12.169Z",
    "updated": "2026-03-10T11:38:12.169Z",
    "status": "PB"
  }
},
{
  "model": "blog.post",
  "pk": 9,
  "fields": {
    "title": "Learning Django Step by Step",
    "slug": "learning-django-step-by-step",
    "author": 4,
    "body": "Django is a high level Python web framework that encourages rapid development and clean design. It follows the Model Template View architecture which helps organize code efficiently. In this project I am creating a blog system where users can view posts, read details, and navigate through the site. Step by step I am learning about models, migrations, templates, and URL routing in Django.",
    "publish": "2026-03-10T11:38:12Z",
    "created": "2026-03-10T11:38:29.066Z",
    "updated": "2026-03-10T11:38:29.066Z",
    "status": "PB"
  }
},
